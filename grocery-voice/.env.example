# --- Public (bundled into the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------------
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared secret Supabase Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-long-random-string

# 32-byte key, base64. Encrypts Home Assistant tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Instacart Developer Platform. Leave the key empty to use the clearly-labelled
# mock provider. INSTACART_ENV is "development" or "production".
INSTACART_API_KEY=
INSTACART_ENV=development

# Email. Leave RESEND_API_KEY empty to log emails to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Grocery Voice <reminders@example.com>"

# Allow plain-http / private-network Home Assistant URLs (local development only).
ALLOW_PRIVATE_HOME_ASSISTANT_URLS=false
